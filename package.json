{
  "name": "flexbox-trainer",
  "publisher": "josebruno10",
  "displayName": "FlexBox Trainer",
  "description": "Extensão para treinamento de recriação de layouts em HTML e CSS, no formato do Frontend Teams Cup.",
  "icon": "resources/icone.png",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josebruno10/flexbox-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/josebruno10/flexbox-trainer/issues"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "html",
    "css",
    "flexbox",
    "layout",
    "treino",
    "frontend teams cup"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flexboxTrainer",
          "title": "FlexBox Trainer",
          "icon": "resources/flexbox-trainer.svg"
        }
      ]
    },
    "views": {
      "flexboxTrainer": [
        {
          "type": "webview",
          "id": "flexbox-trainer.sidebar",
          "name": "Desafio",
          "icon": "resources/flexbox-trainer.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "flexbox-trainer.login",
        "title": "FlexBox Trainer: Fazer Login"
      },
      {
        "command": "flexbox-trainer.logout",
        "title": "FlexBox Trainer: Sair"
      },
      {
        "command": "flexbox-trainer.novoDesafio",
        "title": "FlexBox Trainer: Gerar Novo Desafio"
      },
      {
        "command": "flexbox-trainer.abrirPorCodigo",
        "title": "FlexBox Trainer: Abrir Desafio por Código"
      },
      {
        "command": "flexbox-trainer.refazerDesafio",
        "title": "FlexBox Trainer: Refazer o Desafio Atual"
      },
      {
        "command": "flexbox-trainer.verHistorico",
        "title": "FlexBox Trainer: Histórico de Desafios"
      },
      {
        "command": "flexbox-trainer.abrirGuia",
        "title": "FlexBox Trainer: Guia de Primeiros Passos"
      },
      {
        "command": "flexbox-trainer.abrirGabarito",
        "title": "FlexBox Trainer: Abrir Gabarito em uma Aba"
      },
      {
        "command": "flexbox-trainer.criarArquivos",
        "title": "FlexBox Trainer: Criar index.html e style.css"
      },
      {
        "command": "flexbox-trainer.verExtensoesIa",
        "title": "FlexBox Trainer: Ver Extensões de IA Habilitadas"
      },
      {
        "command": "flexbox-trainer.testarServidor",
        "title": "FlexBox Trainer: Testar Servidor"
      },
      {
        "command": "flexbox-trainer.escolherCores",
        "title": "FlexBox Trainer: Escolher Cores",
        "icon": "$(symbol-color)"
      },
      {
        "command": "flexbox-trainer.criarDinamicaTreino",
        "title": "FlexBox Trainer: Criar Dinâmica de Treino"
      },
      {
        "command": "flexbox-trainer.gerarSolucaoTeste",
        "title": "FlexBox Trainer: Gerar Solução Exata do Desafio (teste)"
      },
      {
        "command": "flexbox-trainer.iniciar",
        "title": "FlexBox Trainer: Iniciar"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flexbox-trainer.gerarSolucaoTeste",
          "when": "config.flexboxTrainer.modoDesenvolvedor"
        },
        {
          "command": "flexbox-trainer.refazerDesafio",
          "when": "flexboxTrainer.temDesafio"
        }
      ],
      "view/title": [
        {
          "command": "flexbox-trainer.escolherCores",
          "when": "view == flexbox-trainer.sidebar",
          "group": "navigation"
        },
        {
          "command": "flexbox-trainer.abrirPorCodigo",
          "when": "view == flexbox-trainer.sidebar",
          "group": "1_desafio@1"
        },
        {
          "command": "flexbox-trainer.refazerDesafio",
          "when": "view == flexbox-trainer.sidebar && flexboxTrainer.temDesafio",
          "group": "1_desafio@2"
        },
        {
          "command": "flexbox-trainer.verHistorico",
          "when": "view == flexbox-trainer.sidebar",
          "group": "1_desafio@3"
        },
        {
          "command": "flexbox-trainer.abrirGuia",
          "when": "view == flexbox-trainer.sidebar",
          "group": "2_ajuda@1"
        },
        {
          "command": "flexbox-trainer.testarServidor",
          "when": "view == flexbox-trainer.sidebar",
          "group": "2_ajuda@2"
        }
      ]
    },
    "configuration": {
      "title": "FlexBox Trainer",
      "properties": {
        "flexboxTrainer.authApiBaseUrl": {
          "type": "string",
          "default": "https://frontendteamscup.com.br/api",
          "scope": "application",
          "description": "URL base da API usada para cadastro, login e validação de sessão."
        },
        "flexboxTrainer.authSiteUrl": {
          "type": "string",
          "default": "https://kevyngreenn.github.io/authserviceflexbox/",
          "scope": "application",
          "description": "URL pública do site externo de autenticação que será aberto no navegador padrão."
        },
        "flexboxTrainer.googleClientId": {
          "type": "string",
          "default": "248632474679-8663hgsnun8q5ddq98cc2kf23u23844p.apps.googleusercontent.com",
          "scope": "application",
          "description": "Client ID OAuth 2.0 da aplicação no Google Cloud Console para habilitar login com Gmail."
        },
        "flexboxTrainer.apiBaseUrl": {
          "type": "string",
          "default": "https://frontendteamscup.com.br/api",
          "scope": "application",
          "description": "URL HTTPS da API usada para avaliar tentativas. Só pode ser alterada nas configurações do usuário."
        },
        "flexboxTrainer.apiToken": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Token manual opcional para desenvolvimento. No uso normal, a extensão utiliza o token da sessão autenticada."
        },
        "flexboxTrainer.eventoTreino": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Código de um evento só de treino, preenchido pelo comando \"FlexBox Trainer: Criar Dinâmica de Treino\". Ao verificar, a extensão cadastra nele a imagem do desafio como gabarito e corrige com corrigir-formas, sem salvar pontuação. O servidor guarda um gabarito por tamanho, então cada desafio substitui o anterior criado pela extensão. Nunca use um evento de competição."
        },
        "flexboxTrainer.modoDesenvolvedor": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Mostra ferramentas de teste, como o comando que gera a solução exata do desafio. Deixe desligado para alunos: a solução entrega a resposta."
        },
        "flexboxTrainer.temaCores": {
          "type": "string",
          "default": "floresta",
          "scope": "application",
          "enum": [
            "floresta",
            "campus",
            "oceano",
            "noite",
            "violeta",
            "magenta",
            "sol",
            "grafite",
            "vscode"
          ],
          "enumItemLabels": [
            "Floresta",
            "Campus",
            "Oceano",
            "Noite",
            "Violeta",
            "Magenta",
            "Pôr do sol",
            "Grafite",
            "Tema do VS Code"
          ],
          "enumDescriptions": [
            "Verdes (padrão)",
            "Verde com toques de vermelho",
            "Azul e verde-água",
            "Anil",
            "Roxo e lilás",
            "Magenta e laranja",
            "Amarelo, laranja e vermelho",
            "Cinzas, para quase nenhuma cor",
            "A cor de destaque do tema que você usa no VS Code"
          ],
          "description": "Cores de destaque do FlexBox Trainer: o degradê, o botão principal e os destaques. O resto segue o tema do VS Code."
        },
        "flexboxTrainer.preCadastro": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Oferece cadastrar no Frontend Teams Cup quem entra com um e-mail que não está no torneio, colocando o aluno no time genérico. Cria o usuário no servidor da competição; fica desligado até as rotas de cadastro serem confirmadas com a organização."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "primeirosPassos",
        "title": "Primeiros passos no FlexBox Trainer",
        "description": "Do login à primeira precisão, treinando como no torneio.",
        "steps": [
          {
            "id": "entrar",
            "title": "Entre com a sua conta",
            "description": "Use a conta cujo e-mail está cadastrado no Frontend Teams Cup, de preferência pelo Google.\n[Abrir o FlexBox Trainer](command:flexbox-trainer.iniciar)",
            "media": {
              "image": {
                "dark": "media/guia/entrar-escuro.png",
                "light": "media/guia/entrar-claro.png",
                "hc": "media/guia/entrar-escuro.png",
                "hcLight": "media/guia/entrar-claro.png"
              },
              "altText": "A tela de entrada do FlexBox Trainer, com Google, GitHub e Microsoft"
            },
            "completionEvents": [
              "onContext:flexboxTrainer.autenticado"
            ]
          },
          {
            "id": "pasta",
            "title": "Abra uma pasta para treinar",
            "description": "Pode ser uma pasta vazia: a extensão cria o index.html e o style.css.\n[Abrir pasta](command:workbench.action.files.openFolder)",
            "media": {
              "image": {
                "dark": "media/guia/pasta-escuro.png",
                "light": "media/guia/pasta-claro.png",
                "hc": "media/guia/pasta-escuro.png",
                "hcLight": "media/guia/pasta-claro.png"
              },
              "altText": "A barra lateral antes do primeiro desafio, com o botão Gerar novo desafio"
            },
            "completionEvents": [
              "onContext:flexboxTrainer.pastaAberta"
            ]
          },
          {
            "id": "gerar",
            "title": "Gere um desafio",
            "description": "Como no torneio, desabilite antes as extensões de IA, como o Copilot: com elas, o desafio não começa.\n[Gerar novo desafio](command:flexbox-trainer.novoDesafio)\n[Ver extensões de IA](command:flexbox-trainer.verExtensoesIa)",
            "media": {
              "image": {
                "dark": "media/guia/gerar-escuro.png",
                "light": "media/guia/gerar-claro.png",
                "hc": "media/guia/gerar-escuro.png",
                "hcLight": "media/guia/gerar-claro.png"
              },
              "altText": "Um desafio na barra lateral, com as medidas de um componente e os dados do gabarito"
            },
            "completionEvents": [
              "onContext:flexboxTrainer.temDesafio"
            ]
          },
          {
            "id": "verificar",
            "title": "Recrie e verifique",
            "description": "Recrie a imagem em index.html e style.css, com flexbox, grid ou position. Clique num componente do gabarito para ver as medidas e a cor. Depois, clique em Verificar: o servidor do torneio devolve a precisão.",
            "media": {
              "image": {
                "dark": "media/guia/verificar-escuro.png",
                "light": "media/guia/verificar-claro.png",
                "hc": "media/guia/verificar-escuro.png",
                "hcLight": "media/guia/verificar-claro.png"
              },
              "altText": "O resultado de uma verificação, com a precisão e as tentativas"
            },
            "completionEvents": [
              "onContext:flexboxTrainer.verificou"
            ]
          },
          {
            "id": "codigo",
            "title": "Treine com a turma",
            "description": "Cada desafio tem um código de 6 dígitos: com o mesmo código, todos treinam o mesmo layout. O histórico guarda a sua melhor nota em cada desafio, e dá para refazer um para bater o recorde.\n[Abrir desafio por código](command:flexbox-trainer.abrirPorCodigo)",
            "media": {
              "image": {
                "dark": "media/guia/codigo-escuro.png",
                "light": "media/guia/codigo-claro.png",
                "hc": "media/guia/codigo-escuro.png",
                "hcLight": "media/guia/codigo-claro.png"
              },
              "altText": "O código do desafio e o histórico com a melhor nota de cada um"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "cores",
            "title": "Escolha as cores",
            "description": "O verde é a cor padrão; há outras, como a Campus, verde com vermelho.\n[Escolher cores](command:flexbox-trainer.escolherCores)",
            "media": {
              "image": {
                "dark": "media/guia/cores-escuro.png",
                "light": "media/guia/cores-claro.png",
                "hc": "media/guia/cores-escuro.png",
                "hcLight": "media/guia/cores-claro.png"
              },
              "altText": "A barra lateral com as cores Campus, em verde e vermelho"
            },
            "completionEvents": [
              "onCommand:flexbox-trainer.escolherCores"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node scripts/testes-web.mjs",
    "pretest": "npm run compile-web",
    "test:desktop": "webpack --env testesDesktop && node scripts/testes-desktop.mjs",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p . --noUnusedLocals --noUnusedParameters",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.110.0",
    "@types/webpack-env": "^1.18.8",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.80",
    "assert": "^2.1.0",
    "eslint": "^9.39.3",
    "mocha": "^11.7.5",
    "process": "^0.11.10",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
