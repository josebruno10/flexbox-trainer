{
  "name": "flexbox-trainer",
  "publisher": "josebruno10",
  "displayName": "FlexBox Trainer",
  "description": "Treinador de recriação de layouts com FlexBox para o VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flexboxTrainer",
          "title": "FlexBox Trainer",
          "icon": "resources/flexbox-trainer.svg"
        }
      ]
    },
    "views": {
      "flexboxTrainer": [
        {
          "type": "webview",
          "id": "flexbox-trainer.sidebar",
          "name": "Desafio"
        }
      ]
    },
    "commands": [
      {
        "command": "flexbox-trainer.login",
        "title": "FlexBox Trainer: Fazer Login"
      },
      {
        "command": "flexbox-trainer.logout",
        "title": "FlexBox Trainer: Sair"
      },
      {
        "command": "flexbox-trainer.iniciar",
        "title": "FlexBox Trainer: Iniciar"
      }
    ],
    "configuration": {
      "title": "FlexBox Trainer",
      "properties": {
        "flexboxTrainer.authApiBaseUrl": {
          "type": "string",
          "default": "https://frontendteamscup.com.br/api",
          "scope": "application",
          "description": "URL HTTPS da API usada para login e validação de sessão. Só pode ser alterada nas configurações do usuário."
        },
        "flexboxTrainer.authSiteUrl": {
          "type": "string",
          "default": "https://kevyngreenn.github.io/authserviceflexbox/",
          "scope": "application",
          "description": "URL HTTPS do site auxiliar que obtém a credencial Google e retorna ao VS Code. O site precisa publicar auth-flow.json na versão 2."
        },
        "flexboxTrainer.googleClientId": {
          "type": "string",
          "default": "248632474679-8663hgsnun8q5ddq98cc2kf23u23844p.apps.googleusercontent.com",
          "scope": "application",
          "description": "Client ID OAuth 2.0 da aplicação Web cadastrada no Google Cloud para o site auxiliar."
        },
        "flexboxTrainer.apiBaseUrl": {
          "type": "string",
          "default": "https://frontendteamscup.com.br/api",
          "scope": "application",
          "description": "URL HTTPS da API usada para avaliar tentativas. Só pode ser alterada nas configurações do usuário."
        },
        "flexboxTrainer.dinamicaId": {
          "type": "string",
          "default": "",
          "description": "Código da dinâmica do torneio informado pelo professor (exemplo: KOTI)."
        },
        "flexboxTrainer.captureWidth": {
          "type": "number",
          "default": 960,
          "description": "Largura usada apenas no preview local do aluno. A correção usa as dimensões do gabarito no servidor."
        },
        "flexboxTrainer.captureHeight": {
          "type": "number",
          "default": 540,
          "description": "Altura usada apenas no preview local do aluno. A correção usa as dimensões do gabarito no servidor."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.110.0",
    "@types/webpack-env": "^1.18.8",
    "@vscode/test-web": "^0.0.80",
    "assert": "^2.1.0",
    "eslint": "^9.39.3",
    "mocha": "^11.7.5",
    "process": "^0.11.10",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
