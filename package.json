{
  "name": "flexbox-trainer",
  "publisher": "josebruno10",
  "displayName": "FlexBox Trainer",
  "description": "Treinador de recriação de layouts com FlexBox para o VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flexboxTrainer",
          "title": "FlexBox Trainer",
          "icon": "resources/flexbox-trainer.svg"
        }
      ]
    },
    "views": {
      "flexboxTrainer": [
        {
          "type": "webview",
          "id": "flexbox-trainer.sidebar",
          "name": "Desafio"
        }
      ]
    },
    "commands": [
      {
        "command": "flexbox-trainer.login",
        "title": "FlexBox Trainer: Fazer Login"
      },
      {
        "command": "flexbox-trainer.criarConta",
        "title": "FlexBox Trainer: Criar Conta"
      },
      {
        "command": "flexbox-trainer.logout",
        "title": "FlexBox Trainer: Sair"
      },
      {
        "command": "flexbox-trainer.iniciar",
        "title": "FlexBox Trainer: Iniciar"
      }
    ],
    "configuration": {
      "title": "FlexBox Trainer",
      "properties": {
        "flexboxTrainer.authApiBaseUrl": {
  "type": "string",
  "default": "http://ifms.pro.br:6009",
  "description": "URL base da API do IFMS usada para cadastro, login e validação de sessão."
},
        "flexboxTrainer.authSiteUrl": {
          "type": "string",
          "default": "https://kevyngreenn.github.io/authserviceflexbox/",
          "description": "URL pública do site externo de autenticação que será aberto no navegador padrão."
        },
        "flexboxTrainer.apiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "URL base da API de torneio para avaliar tentativas (exemplo: https://api.seudominio.com)."
        },
        "flexboxTrainer.apiToken": {
          "type": "string",
          "default": "",
          "description": "Token opcional para autenticar as requisições na API do torneio."
        },
        "flexboxTrainer.dinamicaId": {
          "type": "string",
          "default": "",
          "description": "Código da dinâmica do torneio informado pelo professor (exemplo: KOTI)."
        },
        "flexboxTrainer.userId": {
          "type": "number",
          "default": 0,
          "description": "Identificador numérico do aluno no servidor do torneio."
        },
        "flexboxTrainer.teamId": {
          "type": "number",
          "default": 0,
          "description": "Identificador numérico da equipe no servidor do torneio."
        },
        "flexboxTrainer.captureWidth": {
          "type": "number",
          "default": 960,
          "description": "Largura da imagem capturada para envio ao servidor."
        },
        "flexboxTrainer.captureHeight": {
          "type": "number",
          "default": 540,
          "description": "Altura da imagem capturada para envio ao servidor."
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.110.0",
    "@types/webpack-env": "^1.18.8",
    "@vscode/test-web": "^0.0.80",
    "assert": "^2.1.0",
    "eslint": "^9.39.3",
    "mocha": "^11.7.5",
    "process": "^0.11.10",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}